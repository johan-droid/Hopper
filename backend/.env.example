# ==============================================================================
# HOPPER — BACKEND LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE
# Copy to backend/.env or backend/.env.local. NEVER commit real secrets to git.
# Every value below is a template or safe local default.
# ==============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=Hopper
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Comma-separated. Required in production (wildcard CORS is refused).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_REQUEST_BODY=1mb

# --- Database (Supabase PostgreSQL + pgvector) -------------------------------
# Local: docker-compose pgvector container on port 5432.
# Serverless production: Supabase POOLED connection (port 6543, pgbouncer).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hopper_db
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hopper_db
DB_POOL_MAX=10

# --- Durable Queue & Coordination (PostgreSQL Outbox + Vercel Queues) --------
QUEUE_STORE=postgres
# auto | off | vercel  (off = local polling worker drains PostgreSQL)
QUEUE_TRANSPORT=off
COORDINATION_BACKEND=postgres
QUEUE_DRAIN_BATCH=10
WORKER_CONCURRENCY=3
CRON_SECRET=

# --- Authentication & Identity (GitHub OAuth / Supabase Auth) ---------------
# Signing secret for Hopper user sessions and signed OAuth HMAC state tokens:
JWT_SECRET=dev-jwt-secret-hopper-local-test-token-change-in-prod
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_PUBLIC_KEY=

# --- GitHub App & OAuth ------------------------------------------------------
GITHUB_APP_ID=1029384
GITHUB_APP_CLIENT_ID=Ov23li5VvuBPsGAbWwif
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

# --- AI Providers (puter | mock | openai | anthropic) ------------------------
# puter: Zero-cost AI across DeepSeek, Qwen 2.5 Coder, GPT-4o-mini, Gemini 1.5 Flash
# mock: Deterministic synthesis for local tests without network calls
AI_PROVIDER=mock
AI_MODEL=deepseek-chat
EMBEDDING_MODEL=text-embedding-3-small
# Optional backend Puter token (browser uses free user allowance via window.puter)
PUTER_AUTH_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=500
AI_REQUEST_TIMEOUT_MS=15000
AI_RETRY_INITIAL_DELAY_MS=500

# --- Stripe Billing (Optional) -----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_DEV_9=price_pro_dev_9
STRIPE_PRICE_ID_TEAM_29=price_team_29
ENABLE_COMMERCIAL_QUOTA=false

# --- Feature Toggles & Notifications -----------------------------------------
AUTO_RETRY_POLICY_ENABLED=false
DISCORD_WEBHOOK_URL=
