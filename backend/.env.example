# ==============================================================================
# HOPPER — BACKEND LOCAL DEVELOPMENT ENVIRONMENT
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# Every value below is a placeholder; none is a working credential.
# ==============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=Hopper
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Comma-separated. Required in production (wildcard CORS is refused).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_REQUEST_BODY=1mb

# --- Database (Supabase PostgreSQL + pgvector) -------------------------------
# Local: docker compose pgvector container.
# Serverless production: Supabase POOLED connection (port 6543, pgbouncer).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hopper_db
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hopper_db
DB_POOL_MAX=10

# --- Durable queue (Vercel Queues + PostgreSQL outbox) -----------------------
QUEUE_STORE=postgres
# auto | off | vercel  (off = local polling worker drains PostgreSQL)
QUEUE_TRANSPORT=off
COORDINATION_BACKEND=postgres
QUEUE_DRAIN_BATCH=10
WORKER_CONCURRENCY=3
CRON_SECRET=

# --- Authentication (Supabase Auth) ------------------------------------------
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_PUBLIC_KEY=

# --- GitHub App --------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

# --- AI providers (openai | anthropic | mock) --------------------------------
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=500
AI_REQUEST_TIMEOUT_MS=15000
AI_RETRY_INITIAL_DELAY_MS=500

# --- Stripe billing ----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_DEV_9=
STRIPE_PRICE_ID_TEAM_29=

# --- Feature toggles ---------------------------------------------------------
AUTO_RETRY_POLICY_ENABLED=false
DISCORD_WEBHOOK_URL=
