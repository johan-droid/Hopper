{
  "name": "hopper",
  "version": "1.0.0",
  "type": "module",
  "description": "Hopper - Next-Generation CI/CD Failure Diagnosis Engine & Unified SDLC Lifecycle Runner",
  "main": "dist/index.js",
  "bin": {
    "hopper": "./bin/hopper.js"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsup --config tsup.config.json",
    "lint": "tsc --noEmit",
    "test": "vitest run --no-cache",
    "test:watch": "vitest",
    "doctor": "tsx src/cli/hopper.ts doctor",
    "migrate": "tsx src/cli/hopper.ts migrate",
    "simulate": "tsx src/cli/hopper.ts simulate",
    "lifecycle": "tsx src/cli/hopper.ts lifecycle",
    "start": "node dist/server/index.js",
    "worker": "tsx src/workers/worker-entry.ts",
    "test:smoke": "vitest run tests/backend-smoke.test.ts"
  },
  "keywords": [
    "ci-cd",
    "failure-diagnosis",
    "grace-hopper",
    "sdlc",
    "flakiness-detection",
    "devops",
    "github-actions"
  ],
  "author": "Hopper Engineering",
  "license": "Apache-2.0",
  "dependencies": {
    "@vercel/queue": "^0.8.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.7",
    "@types/pg": "^8.11.10",
    "@vercel/node": "^5.1.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
