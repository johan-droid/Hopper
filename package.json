{
  "name": "hopper-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hopper - Next-Generation CI/CD Failure Diagnosis Engine & Unified SDLC Lifecycle Runner",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint",
    "test": "npm --prefix backend run test",
    "test:backend": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend run test",
    "start": "npm --prefix backend start",
    "local": "node scripts/local/start.mjs",
    "local:stop": "node scripts/local/stop.mjs",
    "local:status": "node scripts/local/status.mjs"
  },
  "author": "Hopper Engineering",
  "license": "Apache-2.0"
}
