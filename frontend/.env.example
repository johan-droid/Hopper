# Hopper Frontend — public variables only (baked into the browser bundle).

# Empty = same origin (unified Vercel deployment). Vite dev proxies /api.
VITE_API_BASE_URL=
# Dev proxy target used by vite.config.ts only.
VITE_API_URL=http://127.0.0.1:3000

VITE_APP_ENV=development
VITE_APP_NAME=Hopper

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Demo sign-in is refused in production builds regardless of this flag.
VITE_DEMO_AUTH_ENABLED=false
