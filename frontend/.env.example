# ==============================================================================
# HOPPER FRONTEND — ENVIRONMENT TEMPLATE
# Copy to frontend/.env or frontend/.env.local.
# Note: Variables prefixed with VITE_ are exposed to the client browser bundle.
# NEVER place backend secrets, private keys, or secret tokens here.
# ==============================================================================

# API Base URL:
# - Leave empty ("") for same-origin routing (standard in production and via Vite dev proxy).
# - Or set to "http://localhost:3000" if running client and API completely decoupled without proxy.
VITE_API_BASE_URL=

# Vite Dev Server Proxy Target (used by vite.config.ts to proxy /api to backend):
VITE_API_URL=http://127.0.0.1:3000

# Application Details & Environment
VITE_APP_NAME=Hopper
VITE_APP_ENV=development

# Identity & Supabase (optional if using direct GitHub OAuth):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Demo login button (disabled in production builds):
VITE_DEMO_AUTH_ENABLED=false
