{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "runtime": "container"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/auth",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/login/callback",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/favicon.(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/puter/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      },
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/index.html"
        }
      ]
    }
  ]
}
