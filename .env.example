# ==============================================================================
# HOPPER — AUTHORITATIVE ENVIRONMENT TEMPLATE (Vercel-native)
# Register: docs/deployment/VERCEL_ENVIRONMENT_VARIABLES.md
# Real secrets belong in backend/.env (git-ignored) or Vercel Project Settings.
# There are NO Cloudflare variables: no API token, account id, Workers AI URL
# or tunnel hostname.
# ==============================================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_REQUEST_BODY=1mb

# Database — pooled URL for serverless runtime, direct URL for migrations
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hopper_db
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hopper_db
DB_POOL_MAX=10

QUEUE_STORE=postgres
QUEUE_TRANSPORT=off
COORDINATION_BACKEND=postgres
QUEUE_DRAIN_BATCH=10
CRON_SECRET=

SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_PUBLIC_KEY=

GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=500

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_DEV_9=
STRIPE_PRICE_ID_TEAM_29=

# Frontend (public — never place secrets here)
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development
VITE_DEMO_AUTH_ENABLED=false
