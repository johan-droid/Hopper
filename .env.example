# ==============================================================================
# HOPPER — AUTHORITATIVE ENVIRONMENT TEMPLATE
# Reference: docs/deployment/VERCEL_ENVIRONMENT_VARIABLES.md
# Real secrets belong in backend/.env (git-ignored) or Vercel Project Settings.
# There are NO Cloudflare or Redis variables.
# ==============================================================================

# --- Runtime & HTTP ----------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=Hopper
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_REQUEST_BODY=1mb

# --- Database (Supabase PostgreSQL + pgvector) -------------------------------
# Pooled URL for serverless/multi-container runtime, direct URL for migrations
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hopper_db
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hopper_db
DB_POOL_MAX=10

# --- Durable Queue & Coordination (PostgreSQL Outbox + Vercel Queues) --------
QUEUE_STORE=postgres
# off (local polling worker) | auto | vercel
QUEUE_TRANSPORT=off
COORDINATION_BACKEND=postgres
QUEUE_DRAIN_BATCH=10
WORKER_CONCURRENCY=3
CRON_SECRET=

# --- Authentication & Identity (GitHub OAuth / Supabase Auth) ---------------
# Signing secret for Hopper user session JWTs and signed HMAC OAuth state:
JWT_SECRET=dev-jwt-secret-hopper-local-test-token-change-in-prod
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_PUBLIC_KEY=

# --- GitHub App & OAuth ------------------------------------------------------
GITHUB_APP_ID=1029384
GITHUB_APP_CLIENT_ID=Ov23li5VvuBPsGAbWwif
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

# --- AI Providers (groq | nvidia-nim | anthropic | openai | mock) -----------
# groq: Primary provider. OpenAI-compatible API at https://api.groq.com/openai/v1
# nvidia-nim: Secondary provider. NVIDIA API Catalog at https://integrate.api.nvidia.com/v1
#   NOTE: NVIDIA Developer Program catalog access is intended for prototyping,
#   research and evaluation — not guaranteed production capacity. See
#   docs/architecture/AI_GATEWAY.md before enabling it for production traffic.
# mock: Deterministic mock for fast local offline tests
AI_PROVIDER=groq
AI_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gateway routing: paid providers (anthropic/openai) are never automatic fallbacks
AI_ENABLE_GROQ=true
AI_ENABLE_NVIDIA_NIM=true
AI_ENABLE_PAID_FALLBACK=false
AI_ROUTING_MODE=failover
AI_MAX_RETRIES=2
AI_MAX_TOKENS_PER_TASK=8000
AI_MAX_ORCHESTRATION_STEPS=4
AI_MAX_TOOL_CALLS=4
AI_MAX_CONCURRENT_REQUESTS=8
AI_ENABLE_PROVIDER_TELEMETRY=true
AI_MONTHLY_BUDGET_USD=500
AI_REQUEST_TIMEOUT_MS=15000
AI_RETRY_INITIAL_DELAY_MS=500

# --- Stripe Billing (Optional) -----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_DEV_9=price_pro_dev_9
STRIPE_PRICE_ID_TEAM_29=price_team_29
ENABLE_COMMERCIAL_QUOTA=false

# --- Feature Toggles & Notifications -----------------------------------------
AUTO_RETRY_POLICY_ENABLED=false
DISCORD_WEBHOOK_URL=

# --- Frontend (Public — never place secrets or private keys here) -----------
VITE_API_BASE_URL=
VITE_API_URL=http://127.0.0.1:3000
VITE_APP_ENV=development
VITE_APP_NAME=Hopper
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_DEMO_AUTH_ENABLED=false
